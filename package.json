{
  "name": "codexdesk",
  "version": "2.9.2",
  "private": true,
  "description": "Desktop workspace for OpenAI Codex CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/nidvjj-sudo/CodexDesk.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "verify": "node scripts/verify-runtime.cjs",
    "build": "npm run verify && npm run build:web && electron-builder --win --x64",
    "release": "npm run verify && npm run build:web && electron-builder --win --x64 --publish always",
    "start": "electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex": "0.149.0",
    "@xhayper/discord-rpc": "1.3.4",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.codexdesk.app",
    "productName": "CodexDesk",
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "nidvjj-sudo",
      "repo": "CodexDesk",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "CodexDesk-Setup-${version}-${arch}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodexDesk",
      "uninstallDisplayName": "CodexDesk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/uninstaller-sidebar.bmp",
      "installerLanguages": [
        "th_TH",
        "en_US"
      ],
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
